{
  "configVersion": "v3",
  "app": {
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "appId": 1129163,
    "appName": "Locks",
    "icon": "icon.png",
    "vender": "personal",
    "description": "Какие замки открыты, какие закрыты: пресеты локаций с переключателями"
  },
  "runtime": {
    "apiVersion": {
      "compatible": "4.0",
      "target": "4.2",
      "minVersion": "4.0"
    }
  },
  "targets": {
    "gt": {
      "module": {
        "page": {
          "pages": [
            "page/home/index.page"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        },
        "app-widget": {
          "widgets": [
            {
              "path": "app-widget/index",
              "icon": "icon.png",
              "name": "Locks",
              "runtime": {
                "type": "js"
              }
            }
          ]
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480
        }
      ]
    }
  },
  "permissions": [
    "data:os.device.info",
    "device:os.local_storage"
  ],
  "i18n": {
    "en-US": {
      "appName": "Locks",
      "app-widget": {
        "widgets": [
          {
            "name": "Locks"
          }
        ]
      }
    },
    "ru-RU": {
      "appName": "Замки",
      "app-widget": {
        "widgets": [
          {
            "name": "Замки"
          }
        ]
      }
    },
    "uk-UA": {
      "appName": "Замки",
      "app-widget": {
        "widgets": [
          {
            "name": "Замки"
          }
        ]
      }
    }
  },
  "defaultLanguage": "en-US",
  "debug": false
}
